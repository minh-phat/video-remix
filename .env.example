# Postgres
POSTGRES_DB=video_remix
POSTGRES_USER=video_remix
POSTGRES_PASSWORD=video_remix
DATABASE_URL=postgresql://video_remix:video_remix@localhost:55432/video_remix

# Redis
REDIS_URL=redis://localhost:6379

# S3-compatible storage (MinIO locally)
S3_ENDPOINT=http://localhost:19000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=video-remix
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Auth
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# Backend/Frontend URLs
PORT=3001
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Third-party AI providers (Phase 5+)
# Google AI Studio key (https://aistudio.google.com/apikey) — used for vision detection,
# OCR, and multimodal embeddings via the Gemini API (primary provider).
GEMINI_API_KEY=
# Optional secondary/fallback provider.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
